includes:
  - vendor/flarum/phpstan/extension.neon

parameters:
  level: 6
  paths:
    - extend.php
    - src
    - vendor/flarum/tags/extend.php
    - vendor/flarum/likes/extend.php
    - vendor/fof/best-answer/extend.php
    - vendor/fof/gamification/extend.php
  excludePaths:
    analyse:
      - *.blade.php
      - vendor/flarum/tags/extend.php
      - vendor/flarum/likes/extend.php
      - vendor/fof/best-answer/extend.php
      - vendor/fof/gamification/extend.php
  databaseMigrationsPath: ['migrations']
